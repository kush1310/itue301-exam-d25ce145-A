  "item": [
    {
      "name": "1. Customer Login (Get JWT Token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"kush@charusat.edu.in\",\n  \"password\": \"password123\",\n  \"requiredRole\": \"Customer\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "2. Get All Restaurants (Public)",
      "request": {
        "method": "GET",
        "header": [],
