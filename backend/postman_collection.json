    {
      "name": "5. Update Order Status (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"preparing\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/orders/{{ORDER_ID}}/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "orders", "{{ORDER_ID}}", "status"]
        }
      },
      "response": []
