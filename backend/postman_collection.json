    {
      "name": "3. Create Order (POST /api/v1/orders -> 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"6a8bf850eff9f04f55049b66\",\n  \"items\": [\n    {\n      \"name\": \"Margherita Woodfired Pizza\",\n      \"quantity\": 1,\n      \"price\": 280\n    },\n    {\n      \"name\": \"Garlic Herb Bread with Cheese\",\n      \"quantity\": 1,\n      \"price\": 150\n    }\n  ],\n  \"totalAmount\": 430,\n  \"deliveryAddress\": \"Hostel Block A, Room 302, CHARUSAT Campus, Changa\",\n  \"status\": \"pending\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "v1", "orders"]
        }
      },
      "response": []
    },
    {
      "name": "4. Get Customer Orders (Populated)",
      "request": {
        "method": "GET",
        "header": [
